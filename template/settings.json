{
        // file path: %appdata%\code\user

        /* 1. text editor */

        "diffEditor.experimental.showMoves":true,
        "diffEditor.experimental.useTrueInlineView": true,
        "diffEditor.hideUnchangedRegions.contextLineCount": 8,
        "diffEditor.hideUnchangedRegions.enabled": true,
        "diffEditor.ignoreTrimWhitespace": false,
        "diffEditor.renderSideBySide": false,
        "diffEditor.useInlineViewWhenSpaceIsLimited": true,
        "editor.accessibilitySupport": "on",
        "editor.cursorBlinking": "smooth",
        "editor.cursorSmoothCaretAnimation": "on",
        "editor.detectIndentation": false,
        "editor.experimentalGpuAcceleration": "on",
        "editor.fastScrollSensitivity": 10,
        "editor.foldingStrategy": "indentation",
        "editor.fontFamily": "Consolas-with-Yahei, monospace",
        "editor.fontLigatures": false,
        "editor.fontSize": 15,
        "editor.fontWeight": "600",
        "editor.guides.bracketPairs": "active",
        "editor.inlayHints.enabled": "off",
        "editor.inlineSuggest.showToolbar": "always",
        "editor.minimap.enabled": false,
        "editor.occurrencesHighlight": "multiFile",
        "editor.rulers": [
                {
                        "column": 80,
                        "color": "#ff0000"
                }
        ],
        "editor.scrollbar.horizontal": "hidden",
        "editor.scrollbar.vertical": "visible",
        "editor.smoothScrolling": true,
        "editor.stickyScroll.enabled": true,
        "editor.stickyScroll.maxLineCount": 20,
        "editor.suggest.showStatusBar": true,
        "editor.suggest.snippetsPreventQuickSuggestions": true,
        "editor.tabSize": 8,
        "editor.tokenColorCustomizations": {
                "comments": "#3CB371",
                "textMateRules": [
                        {
                                "name": "italic bold font",
                                "scope": [
                                        "entity.name.function",
                                        "entity.name.type",
                                        "keyword",
                                        "meta",
                                        "source",
                                        "storage",
                                        "variable",
                                        "variable.parameter"
                                ],
                                "settings": {
                                        "fontStyle": "italic bold"
                                }
                        }
                ]
        },
        "files.associations": {
                "*.h": "c"
        },
        "files.autoGuessEncoding": true,
        "files.autoSave": "onFocusChange",
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.trimTrailingWhitespace": true,
        "multiDiffEditor.experimental.enabled": true,

        /* 2. workbench */

        "workbench.activityBar.location": "bottom",
        "workbench.colorCustomizations": {
                "editorWhitespace.foreground": "#FFFFFF"
        },
        "workbench.colorTheme": "One Dark Darker",
        "workbench.commandPalette.experimental.suggestCommands": true,
        "workbench.editorAssociations": {
                "*.copilotmd": "vscode.markdown.preview.editor",
                "{git,git-graph}:/**/*.{md,csv,svg}": "default"
        },
        "workbench.editor.closeOnFileDelete": true,
        "workbench.editor.pinnedTabsOnSeparateRow": true,
        "workbench.editor.showTabs": "none",
        "workbench.editorLargeFileConfirmation": 10,
        "workbench.experimental.cloudChanges.autoStore": "onShutdown",
        "workbench.experimental.share.enabled": true,
        "workbench.iconTheme": "vscode-icons-mac",
        "workbench.list.smoothScrolling": true,
        "workbench.panel.showLabels": false,
        "workbench.preferredDarkColorTheme": "One Dark Darker",
        "workbench.preferredHighContrastColorTheme": "One Dark Darker",
        "workbench.sideBar.location": "right",
        "workbench.startupEditor": "none",
        "workbench.tree.enableStickyScroll": true,
        "workbench.tree.indent": 30,
        "workbench.tree.stickyScrollMaxItemCount": 7,

        /* 3. window */

        "window.density.editorTabHeight": "compact",
        "window.title": "${rootName}${separator}${activeRepositoryName}${separator}${activeRepositoryBranchName}${separator}${activeEditorMedium}${separator}",

        /* 4. feature */

        "accessibility.signalOptions.volume": 0,
        "accessibility.underlineLinks": true,
        "chat.commandCenter.enabled": false,
        "chat.tools.autoApprove": true,
        "chat.renderRelatedFiles": true,
        "explorer.autoOpenDroppedFile": false,
        "explorer.confirmDelete": false,
        "explorer.confirmDragAndDrop": false,
        "explorer.confirmPasteNative": false,
        "explorer.confirmUndo": "light",
        "explorer.excludeGitIgnore": true,
        "explorer.copyRelativePathSeparator": "/",
        "explorer.fileNesting.enabled": true,
        // "explorer.fileNesting.patterns": {
        //         "*c": "${basename}.c, ${basename}.h"
        // },
        "explorer.incrementalNaming": "smart",
        "explorer.sortOrder": "mixed",
        "extensions.autoCheckUpdates":true,
        "extensions.closeExtensionDetailsOnViewChange": true,
        "inlineChat.accessibleDiffView": "on",
        "notebook.lineNumbers": "on",
        "notebook.outline.showCodeCells": true,
        "notebook.stickyScroll.enabled": true,
        "search.defaultViewMode": "tree",
        "search.showLineNumbers": true,
        "search.smartCase": true,
        "terminal.integrated.copyOnSelection": true,
        "terminal.integrated.cursorBlinking": true,
        "terminal.integrated.cursorStyle": "line",
        "terminal.integrated.defaultProfile.windows": "Git Bash",
        "terminal.integrated.cwd": "${fileDirname}",
        "terminal.integrated.gpuAcceleration": "on",
        "terminal.integrated.smoothScrolling": true,
        "terminal.integrated.stickyScroll.enabled": true,
        "terminal.integrated.tabStopWidth": 8,

        /* 5. application */

        "update.mode": "manual",
        "update.showReleaseNotes": false,

        /* 6. security */

        "security.workspace.trust.enabled": false,

        /* 7. extensions */

        "appworks.enableDataAnalysisServices": false,

        "codesnap.containerPadding": "1em",
        "codesnap.transparentBackground": true,

        "cSpell.enabledFileTypes": {
                "asciidoc": false,
                "cpp": false,
                "csharp": false,
                "css": false,
                "elixir": false,
                "erlang": false,
                "git-commit": false,
                "go": false,
                "graphql": false,
                "handlebars": false,
                "haskell": false,
                "html": false,
                "jade": false,
                "java": false,
                "javascript": false,
                "javascriptreact": false,
                "json": false,
                "jsonc": false,
                "jupyter": false,
                "latex": false,
                "less": false,
                "php": false,
                "plaintext": false,
                "pug": false,
                "python": false,
                "restructuredtext": false,
                "rust": false,
                "scala": false,
                "scminput": false,
                "scss": false,
                "swift": false,
                "typescript": false,
                "typescriptreact": false,
                "vue": false,
                "yaml": false,
                "yml": false
        },
        "cSpell.language": "en, en-GB, en-US, lorem",
        "cSpell.logLevel": "Debug",
        "cSpell.userWords": [
                "consolas",
                "jaxon",
                "malloc",
                "ospi",
                "ruleline",
                "trae",
                "UNISAR",
                "yahei"
        ],

        "C_Cpp.copilotHover": "disabled",
        "C_Cpp.default.cppStandard": "c++11",
        "C_Cpp.default.cStandard": "c99",
        "C_Cpp.errorSquiggles": "enabled",
        "C_Cpp.intelliSenseUpdateDelay": 500,
        "C_Cpp.loggingLevel": "Debug",
        "C_Cpp.vcFormat.indent.preprocessor": "oneLeft",
        "C_Cpp.workspaceSymbols": "All",

        "dictCompletion.addSpaceAfterCompletion": true,
        "dictCompletion.collectWordsFromCurrentFile": true,

        "doxdocgen.generic.linesToGet": 200,
        "doxdocgen.generic.order": [
                "brief",
                "details",
                "empty",
                "param",
                "empty",
                "return",
                "retval"
        ],
        "doxdocgen.generic.paramTemplate": "@param[${{cursor}|in,out,in\\,out|}] {param} ",
        "doxdocgen.generic.returnTemplate": "@return ${cursor}",

        "git.autofetch": true,
        "git.closeDiffOnOperation": true,
        "git.confirmSync": false,
        "git.enableSmartCommit": true,
        "git.openRepositoryInParentFolders": "always",
        "git.postCommitCommand": "sync",
        "git.repositoryScanMaxDepth": -1,
        "git.showPushSuccessNotification": true,

        "githd.logView.commitsCount": 1000,
        "githd.logView.expressMode": true,
        "githd.traceLevel": "verbose",

        "github.copilot.chat.followUps": "always",
        "github.copilot.nextEditSuggestions.enabled": true,

        "git-graph.enhancedAccessibility": true,
        "git-graph.maxDepthOfRepoSearch": 10,

        "psi-header.config": {
                "forceToTop": true,
                "blankLinesAfter": 1,
                "spacesBetweenYears": false,
                "author": "ruleline",
                "authorEmail": "ruleline@outlook.com",
                "creationDateZero": "asIs"
        },
        "psi-header.changes-tracking": {
                "isActive": true,
                "modAuthor": "@authors",
                "modDate": "@date",
                "modDateFormat": "YYYY-MM-DD",
                "autoHeader": "off",
                // "enforceHeader": true,
                "exclude": [
                        "markdown",
                        "json",
                        "jsonc",
                        "shellscript"
                ]
        },
        "psi-header.lang-config": [
                {
                        "language": "*",
                        "begin": "/**",
                        "prefix": " * ",
                        "end": " */"
                }
        ],
        "psi-header.templates": [
                {
                        "language": "*",
                        "template": [
                                "@file <<filename>>",
                                "@brief <<filenamebase!L>>",
                                "@author <<author>> (<<authorEmail>>)",
                                "@since <<filecreated('YYYY-MM-DD')>>",
                                "",
                                "@authors <<author>> (<<authorEmail>>)",
                                "@date <<dateformat('YYYY-MM-DD')>>",
                                "@version 0.00.001",
                                "",
                                "@copyright ©<<yeartoyear(fc, now)>> <<author>>",
                                "",
                                "@details",
                                "-----------------------------------------------------------------------------",
                                "   version   |    date    |       by       |              comments",
                                "------------ | ---------- | -------------- | --------------------------------",
                                "  0.00.001   | <<dateformat('YYYY-MM-DD')>> |    <<author>>    | initial commit",
                                "-----------------------------------------------------------------------------"
                        ],
                        "changeLogCaption": "@details",
                        "changeLogHeaderLineCount": 3,
                        "changeLogEntryTemplate": [
                                "  0.00.001   | <<dateformat('YYYY-MM-DD')>> |    <<author>>    | "
                        ]
                }
        ],

        "projectManager.any.maxDepthRecursion": 0,
        "projectManager.confirmSwitchOnActiveWindow": "always",
        "projectManager.git.maxDepthRecursion": 0,
        "projectManager.hg.maxDepthRecursion": 0,
        "projectManager.svn.maxDepthRecursion": 0,
        "projectManager.vscode.maxDepthRecursion": 0,

        "todo-tree.filtering.ignoreGitSubmodules": true,
        "todo-tree.general.automaticGitRefreshInterval": 10,
        "todo-tree.general.periodicRefreshInterval": 10,
        "todo-tree.general.rootFolder": "${workspaceFolder}",
        "todo-tree.general.showActivityBarBadge": true,
        "todo-tree.general.showIconsInsteadOfTagsInStatusBar": true,
        "todo-tree.general.statusBar": "tags",
        "todo-tree.highlights.enabled": true,
        "todo-tree.tree.buttons.export": true,
        "todo-tree.tree.buttons.groupBySubTag": true,
        "todo-tree.tree.buttons.scanMode": true,
        "todo-tree.tree.expanded": true,
        "todo-tree.tree.flat": true,
        "todo-tree.tree.showCountsInTree": true,

        "trae.codeCompletionPro": {
                "enableCodeCompletionPro": true,
                "enableTabKeyboardShortcuts": true
        },

        "vscode-office.chromiumPath": "%localappdata%\\centbrowser\\browser\\application\\chrome.exe",
        "vscode-office.editorLanguage": "zh_CN",
        "vscode-office.editorTheme": "Auto",
        "vscode-office.openOutline": false
}
